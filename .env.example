# Copy to .env. Every setting is REEL_<NAME>; see src/reel/config.py.

# Lake on local disk (default: ./data/lake) ...
# REEL_LAKE_URL=file:///absolute/path/to/data/lake
# ... or on MinIO (docker compose --profile s3 up) / S3 in prod:
# REEL_LAKE_URL=s3://reel-lake/lake
# REEL_S3_ENDPOINT_URL=http://localhost:9000
# REEL_S3_ACCESS_KEY_ID=reel
# REEL_S3_SECRET_ACCESS_KEY=reel-dev-secret

REEL_PG_DSN=postgresql://reel:reel@localhost:5433/reel

# TMDB "API Read Access Token" (the long eyJ... one). Not needed in Claude Code cloud sessions
# where the network proxy injects it.
# REEL_TMDB_TOKEN=

# MovieLens: ml-latest-small for a fast loop, ml-25m for the Tag Genome (mood signal).
REEL_MOVIELENS_VARIANT=ml-latest-small

# Letterboxd users whose RSS the daily job ingests (comma-separated).
# REEL_LETTERBOXD_USERS=yourname

# Seed sizing
REEL_SEED_TOP_VOTED=10000
REEL_SEED_POPULAR=2000
